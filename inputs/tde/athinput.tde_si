<hydro>
gamma = 1.333333333333333 # gamma = C_p/C_v
dfloor          = 1.e-20 # density floor
pfloor          = 1.e-23  # pressure floor

<problem>

rho1    =   8.1640426e-14
K1      =    0.0824067174
y1      =     -334.720399
xdot1   =   -0.0331154223
