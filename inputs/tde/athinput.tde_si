<comment>
problem   = TDE self-intersection
reference =
configure = --prob=tde_si

<job>
problem_id = tde_si  # problem ID: basename of output filenames

<output1>
file_type  = hdf5      # HDF5 data dump
variable   = prim      # variables to be output
dt         = 10.0     # time increment between outputs
next_time = 0.0
x3_dsum = true

<time>
cfl_number =             0.3  # CFL number
nlim       =              -1  # cycle limit
tlim       =            100000 # cycle limit
integrator =             vl2  # time integration algorithm
xorder     =               2  # order of spatial reconstruction
ncycle_out =               1  # interval for stdout summary info
start_time =             0.0  # time of simulation start
dt_max     =             2.0  # maximum timestep 

<mesh>
nx1        = 256                # Number of zones in X1-direction
x1min      = -1312.0              # minimum value of X1
x1max      = -812.0             # maximum value of X1
ix1_bc     = user               # inner-X1 boundary flag
ox1_bc     = user               # outer-X1 boundary flag
refinement = static

nx2        = 256                # Number of zones in X2-direction
x2min      = -762.0               # minimum value of X2
x2max      = -262.0                # maximum value of X2
ix2_bc     = user            # inner-X2 boundary flag
ox2_bc     = user           # outer-X2 boundary flag

nx3        = 192                 # Number of zones in X3-direction
x3min      = -187.5                  # minimum value of X3
x3max      = 187.5                # maximum value of X3
ix3_bc     = user         # inner-X3 boundary flag
ox3_bc     = user            # outer-X3 boundary flag

<meshblock>
nx1        = 16
nx2        = 16
nx3        = 16

<refinement1>
x1min =           -1312
x1max =       -1296.375
x2min =     -593.386064
x2max =     -553.386064
x3min =             -10
x3max =              10
level =               3

