<comment>
problem   = TDE self-intersection
reference =
configure = --prob=tde_si

<job>
problem_id = tde_si  # problem ID: basename of output filenames

<output1>
file_type  = hdf5      # HDF5 data dump
variable   = prim  # variables to be output
id         = slicez
dt         = 100.0      # time increment between outputs
next_time  = 0.0
x3_slice   = 0.0

#<output2>
#file_type  = hdf5      # HDF5 data dump
#variable   = one,prim # variables to be output
#id         = sumz
#dt         = 100.0      # time increment between outputs
#next_time  = 0.0
#x3_dsum    = true

#<output3>
#file_type  = hdf5      # HDF5 data dump
#variable   = one,prim # variables to be output
#id         = sumy
#dt         = 100.0      # time increment between outputs
#next_time  = 0.0
#x2_dsum    = true

#<output4>
#file_type  = hdf5      # HDF5 data dump
#variable   = uov # variables to be output
#id         = tavg
#dt         = 1000.0      # time increment between outputs
#next_time  = 1000.0

<output5>
file_type  = rst      # restart data dump
id         = restart
dt         = 1000.0      # time increment between outputs
next_time  = 1000.0

#<output6>
#file_type  = hst      # restart data dump
#id         = history
#dt         = 1.0      # time increment between outputs
#data_format = %.12e  # output data format

#<output7>
#file_type  = hdf5      # HDF5 data dump
#variable   = d,p,v     # variables to be output
#id         = debug
#dt         = 10.0      # time increment between outputs

<time>
cfl_number =             0.3  # CFL number
nlim       =              -1  # cycle limit
tlim       =            100000 # cycle limit
integrator =             vl2  # time integration algorithm
xorder     =               2  # order of spatial reconstruction
ncycle_out =               1  # interval for stdout summary info
start_time =             0.0  # time of simulation start
dt_max     =             2.0  # maximum timestep 

<radiation>
nmu = 2
prat = 27832037481.61566
crat = 1.0
n_frequency = 1
nlimit           = 50       # maximum number of iterations to try
error_limit      = 1.e-6    # tolerance level of iteration

<mesh>
nx1        = 128                # Number of zones in X1-direction
x1min      = -1137.0              # minimum value of X1
x1max      = -887.0             # maximum value of X1
ix1_bc     = user               # inner-X1 boundary flag
ox1_bc     = user               # outer-X1 boundary flag
refinement = static

nx2        = 128                # Number of zones in X2-direction
x2min      = -618.0               # minimum value of X2
x2max      = -368.0                # maximum value of X2
ix2_bc     = user            # inner-X2 boundary flag
ox2_bc     = user           # outer-X2 boundary flag

nx3        = 128                 # Number of zones in X3-direction
x3min      = -125.0                  # minimum value of X3
x3max      = 125.0                # maximum value of X3
ix3_bc     = user         # inner-X3 boundary flag
ox3_bc     = user            # outer-X3 boundary flag

<meshblock>
nx1        = 32
nx2        = 32
nx3        = 32

